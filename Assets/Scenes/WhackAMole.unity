  m_text: "1. \u70B9\u51FB\u300C\u5F00\u59CB\u6E38\u620F\u300D\u8FDB\u5165\u5173\u5361\uFF0C\u9650\u65F6
    60 \u79D2\u3002\n2. \u5730\u9F20\u4F1A\u4ECE\u6D1E\u53E3\u5192\u51FA\uFF0C\u7528\u9524\u5B50\u5149\u6807\u70B9\u51FB\u5B83\u5373\u53EF\u5F97\u5206\uFF0C\u6BCF\u6B21
    +10 \u5206\u3002\n3. \u5730\u9F20\u5B8C\u5168\u5192\u51FA\u540E\u624D\u5224\u5B9A\u547D\u4E2D\uFF0C\u6B63\u5728\u5192\u5934\u6216\u5DF2\u7ECF\u7F29\u56DE\u53BB\u65F6\u6253\u4E0D\u5230\u3002\n4.
    \u6CA1\u88AB\u6253\u4E2D\u7684\u5730\u9F20\u4F1A\u5728\u4E00\u6BB5\u65F6\u95F4\u540E\u81EA\u52A8\u7F29\u56DE\u6D1E\u53E3\u3002\n5.
    \u65F6\u95F4\u8017\u5C3D\u540E\u7ED3\u7B97\uFF1A\u8FBE\u5230 30 \u5206\u7B97\u4F60\u8D62\uFF0C\u5426\u5219\u88AB\u5730\u9F20\u4EEC\u5F97\u901E\u3002\n6.
    \u97F3\u4E50\u548C\u97F3\u6548\u7684\u97F3\u91CF\u53EF\u4EE5\u5728\u300C\u6E38\u620F\u8BBE\u7F6E\u300D\u91CC\u8C03\u8282\uFF0C\u8BBE\u7F6E\u4F1A\u81EA\u52A8\u8BB0\u4F4F\u3002"
